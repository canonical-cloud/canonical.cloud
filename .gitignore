# Dependencies & build artifacts (rebuilt in-pod / locally; never committed)
**/node_modules/
canonical-marketing-site.web/dist/
canonical-marketing-site.web/.astro/
canonical-web-server.rs/target/
canonical-web-server.rs/static/

# The nested monorepo owns these as submodules. The umbrella repository vendors
# the superproject files only; staging these checkouts here would create broken
# root-level gitlinks without matching root-level .gitmodules entries.
canonical-monorepo/apps/

# misc
.DS_Store
*.log
tmp
temp
tmp/worktrees
temp/worktrees

# --- environment / secrets (sops + age) -------------------------------------
# Only env/enc/*.env.enc is tracked. Every plaintext form stays out of git;
# `just env-check` enforces it. See env/README.md.
.env
.env.*
*.env
**/*.env
env/dec/
!.env.example

# age private keys — never commit these.
*.agekey
*.age-key
keys.txt
sops-private*.txt
